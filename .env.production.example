# ---------------------------------------------------------------------------
# Продовое окружение. Скопировать в .env.production и заполнить.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Файл содержит пароли и секрет подписи токенов. В репозиторий он НЕ попадает
# (см. .gitignore) и на сервере должен быть доступен только владельцу:
#   chmod 600 .env.production
# ---------------------------------------------------------------------------

# Домен панели. Должен указывать A-записью на этот сервер — по нему Caddy
# получит сертификат Let's Encrypt.
DOMAIN=crm.pardabozor.uz

# Почта для уведомлений об истечении сертификата.
ACME_EMAIL=admin@pardabozor.uz

# --- База данных -----------------------------------------------------------
# Пароль не оставлять «curtain»: контейнер СУБД наружу не публикуется, но
# доступ к нему получит любой процесс в сети docker.
POSTGRES_USER=curtain
POSTGRES_PASSWORD=
POSTGRES_DB=curtain_crm

# --- Токены ----------------------------------------------------------------
# Минимум 32 символа, иначе процесс не стартует. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Этим же секретом подписываются ссылки на файлы, поэтому его смена
# разом обесценит и выданные токены, и выданные ссылки — это нормально.
JWT_SECRET=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Хранилище файлов ------------------------------------------------------
# disk — файлы в томе `storage` рядом с API. Резервное копирование обязательно:
#   pnpm --filter @curtain-crm/api backup
# s3 — файлы в бакете; тогда нужны все пять переменных ниже.
STORAGE_DRIVER=disk

MAX_UPLOAD_SIZE_MB=15

# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=curtain-crm
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Первый запуск ---------------------------------------------------------
# Эти переменные читает `pnpm db:seed`, который выполняется один раз вручную
# после первого поднятия. Пароль директора сменить сразу после входа.
SEED_CEO_NAME=Директор
SEED_CEO_PHONE=+998901234567
SEED_CEO_PASSWORD=
SEED_BRANCH_NAME=Цех №1
SEED_BRANCH_LAT=41.311081
SEED_BRANCH_LON=69.240562
SEED_PAYROLL_EFFECTIVE_FROM=2026-01-01
