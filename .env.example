# ---------------------------------------------------------------------------
# Корневой .env — общие для монорепозитория переменные.
# Скопируйте в .env: cp .env.example .env
# Переменные, специфичные для API, лежат в apps/api/.env.example
# ---------------------------------------------------------------------------

# PostgreSQL (соответствует docker-compose.yml)
POSTGRES_USER=curtain
POSTGRES_PASSWORD=curtain
POSTGRES_DB=curtain_crm
POSTGRES_PORT=5432

# Строка подключения для Drizzle и API
DATABASE_URL=postgresql://curtain:curtain@localhost:5432/curtain_crm

NODE_ENV=development
