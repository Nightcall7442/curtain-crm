{
  "name": "curtain-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM для шторной мастерской Design House",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @curtain-crm/db db:generate",
    "db:migrate": "pnpm --filter @curtain-crm/db db:migrate",
    "db:push": "pnpm --filter @curtain-crm/db db:push",
    "db:studio": "pnpm --filter @curtain-crm/db db:studio",
    "db:seed": "pnpm --filter @curtain-crm/db db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0"
  }
}
