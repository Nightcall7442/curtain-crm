{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowJs": true,

    // Выключен по той же причине, что и в apps/web: несовместимость с типами
    // React Navigation и Expo. `strict` и `noUncheckedIndexedAccess` включены.
    "exactOptionalPropertyTypes": false,

    // Приложение не публикует типы. С `declaration: true` компилятор требует,
    // чтобы каждый выводимый тип можно было назвать в будущем `.d.ts`, а
    // клиент tRPC выводится из `AppRouter` через симлинки pnpm — получается
    // TS2742, которая здесь ничего не защищает.
    "declaration": false,
    "declarationMap": false,
    "types": ["react", "react-native"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".expo"]
}
