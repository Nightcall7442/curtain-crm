# ---------------------------------------------------------------------------
# apps/api — переменные окружения.
# Скопируйте в apps/api/.env. Значения из корневого .env подхватываются тоже,
# локальный файл имеет приоритет.
# ---------------------------------------------------------------------------

# Подключение к PostgreSQL
DATABASE_URL=postgresql://curtain:curtain@localhost:5432/curtain_crm

# HTTP-сервер
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО замените в проде.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-replace-me-with-48-random-bytes-min

# Время жизни токенов
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# API за обратным прокси? От этого зависит, чей адрес считается адресом
# клиента при ограничении обращений к auth.*. Оставьте false при прямом
# подключении: X-Forwarded-For подделывается, и лимит обходился бы им.
TRUST_PROXY_HEADERS=false

# Источники, которым разрешён доступ к API (веб-панель, Expo dev-сервер).
# Через запятую. Мобильное приложение CORS не использует.
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Файловое хранилище: disk (локальный диск) или s3
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./storage
# Базовый URL, по которому раздаются файлы disk-драйвера
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/files

# Настройки S3 — нужны только при STORAGE_DRIVER=s3. Обязательны ВСЕ ПЯТЬ:
# без любой из них процесс не стартует, чтобы загрузки не деградировали молча.
# Драйвер работает и с AWS, и с совместимыми хранилищами (MinIO, Yandex
# Object Storage, Cloudflare R2) — адресация всегда путевая.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=curtain-crm
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Проверить драйвер без настоящего бакета:
#   pnpm --filter @curtain-crm/api s3:check

# Ограничения загрузки
MAX_UPLOAD_SIZE_MB=15
