# Не спрашивать подтверждения при пересборке node_modules: в неинтерактивной
# среде (CI, скрипты) вопрос «Proceed? (Y/n)» просто вешает установку.
confirm-modules-purge=false

# Пакеты рантайма Expo поднимаются в корневой node_modules: Metro и
# сборка EAS резолвят их от файла-потребителя, и в строгой изоляции pnpm
# `expo-haptics` не находил `expo-modules-core`, `@expo/vector-icons` —
# `expo-font`, а Gradle-таска `createBundleReleaseJsAndAssets` на EAS —
# `expo-asset`. Паттерны широкие намеренно: точечный список превращался
# в игру в кошки-мышки — каждая новая транзитивная зависимость Expo
# валила сборку заново.
#
# Хойстинг не заменяет прямых зависимостей: нативный модуль, который
# требует другой пакет (`expo-asset` для `expo-audio`), `expo-doctor`
# велит объявлять в package.json мобилки явно — иначе приложение падает
# вне Expo Go. Хойстинг решает, ГДЕ пакет лежит, а не то, объявлен ли он.
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@expo/*
