# Не спрашивать подтверждения при пересборке node_modules: в неинтерактивной
# среде (CI, скрипты) вопрос «Proceed? (Y/n)» просто вешает установку.
confirm-modules-purge=false

# Пакеты рантайма Expo поднимаются в корневой node_modules: Metro резолвит
# их от файла-потребителя, и в строгой изоляции pnpm `expo-haptics` не
# находил `expo-modules-core`, а `@expo/vector-icons` — `expo-font`.
# Хостинг-паттерн — рекомендованный способ для pnpm-монорепо с Expo;
# прямые зависимости в package.json мобилки ставить нельзя —
# `expo-doctor` считает это ошибкой.
public-hoist-pattern[]=expo-modules-core
public-hoist-pattern[]=expo-font
